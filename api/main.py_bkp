import os
import time
import json
import numpy as np
from fastapi import FastAPI, Request, HTTPException
from pydantic import BaseModel
from langchain_ollama import OllamaLLM, OllamaEmbeddings
from langchain_community.vectorstores import Redis as RedisVectorStore
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.runnables import RunnablePassthrough
from langchain_core.output_parsers import StrOutputParser
from langchain_text_splitters import CharacterTextSplitter
from langchain_core.documents import Document
import redis

app = FastAPI(title="API LangChain Local com Semantic Cache Vetorial e Redis")

OLLAMA_URL = os.getenv("OLLAMA_BASE_URL", "http://ollama:11434")
REDIS_URL = os.getenv("REDIS_URL", "redis://redis:6379")

llm = OllamaLLM(base_url=OLLAMA_URL, model="llama3.1")
embeddings = OllamaEmbeddings(base_url=OLLAMA_URL, model="nomic-embed-text")
redis_client = redis.Redis.from_url(REDIS_URL, decode_responses=True)

global_vectorstore = None

class QueryRequest(BaseModel):
    question: str
    manual_prompt: str = None

def cosine_similarity(a, b):
    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))

def carregar_vetores():
    global global_vectorstore
    # Caminho absoluto dentro do container para a pasta docs na raiz do projeto
    docs_path = "/app/docs"
    if not os.path.exists(docs_path):
        docs_path = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "docs"))
        
    print(f"DEBUG: Procurando documentos em: {docs_path}")

    if os.path.exists(docs_path):
        try:
            documents = []
            for root, dirs, files in os.walk(docs_path):
                for file in files:
                    if file.endswith(".md"):
                        file_path = os.path.join(root, file)
                        with open(file_path, "r", encoding="utf-8") as f:
                            content = f.read()
                            documents.append(Document(page_content=content, metadata={"source": file_path}))

            print(f"DEBUG: Total de documentos .md carregados via Python nativo: {len(documents)}")

            if documents:
                text_splitter = CharacterTextSplitter(chunk_size=500, chunk_overlap=50)
                docs = text_splitter.split_documents(documents)

                global_vectorstore = RedisVectorStore.from_documents(
                    docs,
                    embeddings,
                    redis_url=REDIS_URL,
                    index_name="rag_docs"
                )
                print("SUCESSO: Documentos indexados no Redis Vector Store!")
                return True
            else:
                print("AVISO: Nenhum arquivo .md encontrado na pasta docs.")
        except Exception as e:
            print(f"ERRO na indexação automática: {e}")
    return False

@app.on_event("startup")
def startup_event():
    carregar_vetores()

@app.post("/reindexar")
def reindexar():
    sucesso = carregar_vetores()
    return {"status": "sucesso" if sucesso else "falha", "vectorstore_ativo": global_vectorstore is not None}

def buscar_cache_semantico(pergunta_atual: str, threshold: float = 0.78):
    try:
        vetor_atual = embeddings.embed_query(pergunta_atual)
        chaves = redis_client.keys("sem_cache:*")

        melhor_similaridade = 0.0
        resposta_encontrada = None

        for chave in chaves:
            dados_raw = redis_client.get(chave)
            if dados_raw:
                dados = json.loads(dados_raw)
                vetor_salvo = dados["embedding"]

                sim = cosine_similarity(vetor_atual, vetor_salvo)
                if sim > melhor_similaridade:
                    melhor_similaridade = sim
                    resposta_encontrada = dados["resposta"]

        if melhor_similaridade >= threshold:
            return resposta_encontrada, melhor_similaridade

    except Exception as e:
        print(f"Erro ao consultar cache semântico: {e}")

    return None, 0.0

@app.post("/perguntar")
def perguntar(req: QueryRequest, request: Request):
    start_time = time.time()
    headers_dict = dict(request.headers)
    header_size_bytes = sum(len(k) + len(v) for k, v in headers_dict.items())
    query_text = req.manual_prompt if req.manual_prompt else req.question

    resposta_cache, similaridade = buscar_cache_semantico(req.question, threshold=0.78)

    if resposta_cache:
        elapsed_time = round(time.time() - start_time, 4)
        source = "cache_semantico_redis"

        metric_entry = {
            "source": source,
            "type": "rag_query",
            "question": req.question,
            "similarity_score": round(float(similaridade), 4),
            "context_used": query_text,
            "header_size_bytes": header_size_bytes,
            "execution_time_seconds": elapsed_time,
            "timestamp": time.time()
        }
        redis_client.rpush("lab_metrics", json.dumps(metric_entry))

        return {
            "source": source,
            "similarity_score": round(float(similaridade), 4),
            "execution_time_seconds": elapsed_time,
            "header_size_bytes": header_size_bytes,
            "answer": resposta_cache
        }

    try:
        global global_vectorstore
        if not global_vectorstore:
            raise Exception("Vectorstore não inicializado.")

        retriever = global_vectorstore.as_retriever(search_kwargs={"k": 3})

        template = "Responda à pergunta detalhadamente com base estritamente no contexto abaixo:\n\n{context}\n\nPergunta: {question}"
        prompt = ChatPromptTemplate.from_template(template)

        chain = (
            {"context": retriever | (lambda docs: "\n\n".join([d.page_content for d in docs]) if docs else "Nenhum contexto encontrado."), "question": RunnablePassthrough()}
            | prompt
            | llm
            | StrOutputParser()
        )

        response = chain.invoke(query_text)
        elapsed_time = round(time.time() - start_time, 4)
        source = "llm_generated_rag"

        vetor_pergunta = embeddings.embed_query(req.question)
        cache_payload = {
            "embedding": vetor_pergunta,
            "resposta": response
        }
        redis_client.setex(f"sem_cache:{int(time.time()*1000)}", 86400, json.dumps(cache_payload))

        metric_entry = {
            "source": source,
            "type": "rag_query",
            "question": req.question,
            "context_used": query_text,
            "header_size_bytes": header_size_bytes,
            "execution_time_seconds": elapsed_time,
            "timestamp": time.time()
        }
        redis_client.rpush("lab_metrics", json.dumps(metric_entry))

        return {
            "source": source,
            "execution_time_seconds": elapsed_time,
            "header_size_bytes": header_size_bytes,
            "answer": response
        }

    except Exception as e:
        print(f"RAG Falhou, usando fallback direto: {e}")
        try:
            response = llm.invoke(query_text)
            elapsed_time = round(time.time() - start_time, 4)
            source = "llm_fallback"

            vetor_pergunta = embeddings.embed_query(req.question)
            cache_payload = {
                "embedding": vetor_pergunta,
                "resposta": response
            }
            redis_client.setex(f"sem_cache:{int(time.time()*1000)}", 86400, json.dumps(cache_payload))

            metric_entry = {
                "source": source,
                "type": "rag_query_fallback",
                "question": req.question,
                "context_used": query_text,
                "header_size_bytes": header_size_bytes,
                "execution_time_seconds": elapsed_time,
                "timestamp": time.time()
            }
            redis_client.rpush("lab_metrics", json.dumps(metric_entry))

            return {
                "source": source,
                "execution_time_seconds": elapsed_time,
                "header_size_bytes": header_size_bytes,
                "answer": response
            }
        except Exception as inner_e:
            raise HTTPException(status_code=500, detail=str(inner_e))

@app.get("/metricas-laboratorio")
def obter_metricas():
    raw_metrics = redis_client.lrange("lab_metrics", 0, -1)
    metrics = [json.loads(m if isinstance(m, str) else m.decode("utf-8")) for m in raw_metrics]

    total_consultas = len(metrics)
    total_llm = sum(1 for m in metrics if "llm" in m["source"])
    total_cache = sum(1 for m in metrics if "cache" in m["source"])

    tempo_medio = sum(m["execution_time_seconds"] for m in metrics) / total_consultas if total_consultas > 0 else 0

    return {
        "resumo_geral": {
            "total_registros_laboratorio": total_consultas,
            "consultas_processadas_llm": total_llm,
            "consultas_reaproveitadas_cache": total_cache,
            "tempo_medio_execucao_segundos": round(tempo_medio, 4)
        },
        "detalhado_por_requisicao": metrics
    }
